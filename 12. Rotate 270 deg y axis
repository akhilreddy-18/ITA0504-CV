import cv2
import numpy as np
import matplotlib.pyplot as plt
from PIL import Image

# Load the already uploaded image
image_path = 'king.jpg'
try:
    img_array = np.array(Image.open(image_path))
    
    # 270-degree clockwise rotation (equivalent to 90 degrees counter-clockwise)
    rotated_270 = cv2.rotate(img_array, cv2.ROTATE_90_COUNTERCLOCKWISE)
    
    # Display the result
    fig, axes = plt.subplots(1, 2, figsize=(12, 6))
    
    axes[0].imshow(img_array)
    axes[0].set_title("Original Image")
    axes[0].axis('off')
    
    axes[1].imshow(rotated_270)
    axes[1].set_title("270° Clockwise Rotated")
    axes[1].axis('off')
    
    plt.tight_layout()
    plt.show()
except FileNotFoundError:
    print(f"Could not find '{image_path}'. Please run the first cell to upload it first.")
